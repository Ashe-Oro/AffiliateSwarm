# =============================================================================
# AffiliateSwarm — Environment Variables
# =============================================================================
# Copy this file to .env and fill in the values.
#   cp .env.example .env
# =============================================================================

# Database (required)
DATABASE_URL="postgresql://affiliateswarm:affiliateswarm_dev@localhost:5432/affiliateswarm?schema=public"

# Application (required)
NEXT_PUBLIC_APP_URL="http://localhost:3000"
NEXT_PUBLIC_SHORT_URL="http://localhost:3000"
NODE_ENV="development"

# API Key Encryption (required — generate with: openssl rand -hex 32)
HMAC_ENCRYPTION_KEY="generate-a-32-byte-hex-key-here"

# USDC on Base — Chain Integration (required for onchain payments)
# Keys live in Coinbase Developer Platform; platform never stores private keys.
CHAIN_NETWORK="base"  # "base" (mainnet) or "base-sepolia" (testnet for e2e)
BASE_RPC_URL="https://api.developer.coinbase.com/rpc/v1/base/YOUR_KEY"
CDP_API_KEY_ID="your-cdp-api-key-id"
CDP_API_KEY_PRIVATE_KEY="your-cdp-api-key-secret"
CDP_WALLET_SECRET="your-cdp-wallet-secret"

# Admin Authentication (required — generate with: openssl rand -hex 32)
ADMIN_SECRET="generate-a-32-byte-hex-key-here"

# Cron Jobs (required — used by Vercel Cron to authenticate sweep endpoint)
CRON_SECRET="generate-a-32-byte-hex-key-here"

# Sandbox Database (optional — enables swarm_test_ API keys to route to sandbox)
# SANDBOX_DATABASE_URL="postgresql://user:pass@host:5432/affiliateswarm_sandbox"

# Stripe Payments (required for card/ACH deposits)
STRIPE_SECRET_KEY="sk_test_..."
STRIPE_WEBHOOK_SECRET="whsec_..."

# Email (Resend — required for verification and onboarding emails)
RESEND_API_KEY="re_..."

# Platform Fee (optional — defaults to 0.05 / 5% if not set)
PLATFORM_FEE_RATE="0.05"
NEXT_PUBLIC_PLATFORM_FEE_RATE="0.05"

# Optional: Redis (for local development with docker-compose)
# REDIS_URL="redis://localhost:6379"
