# Twitter Authentication (session tokens from browser)
# To get these: Log into x.com, open DevTools > Application > Cookies
TWITTER_AUTH_TOKEN=your_auth_token_here
TWITTER_CT0=your_ct0_token_here
TWITTER_USERNAME=your_twitter_username

# Venice.AI API
VENICE_API_KEY=your_venice_api_key_here

# Platform Configuration
PLATFORM_URL=http://localhost:3000

# Agent Configuration
AGENT_NAME=venice-affiliate-agent
AGENT_DESCRIPTION=AI agent promoting Venice.AI products
